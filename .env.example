# ---------------------------------------------------------------------------
# VSI — Variables de medición.
#
# Copia este archivo a `.env.local` para desarrollo, y crea las mismas
# variables en Vercel → Project → Settings → Environment Variables.
#
# Todas son NEXT_PUBLIC_* porque se ejecutan en el navegador: NO son secretos.
# Todas son OPCIONALES: si están vacías la web funciona igual, simplemente sin
# enviar datos a Google (útil en desarrollo).
#
# ⚠️ Next.js inyecta estos valores en tiempo de BUILD. Después de cambiar una
#    variable en Vercel hay que volver a desplegar (Redeploy) para que aplique.
#
# Guía completa de configuración: GOOGLE-ADS-SETUP.md
# ---------------------------------------------------------------------------

# --- FUENTE PRINCIPAL DE ETIQUETADO ----------------------------------------
# Contenedor de Google Tag Manager. Es la única variable que necesitas para el
# esquema recomendado (GTM → GA4 + Google Ads).
# Si está definida, gtag.js NO se carga y las conversiones las dispara solo GTM.
NEXT_PUBLIC_GTM_ID=GTM-KVTLX92L

# --- FALLBACK SIN GTM ------------------------------------------------------
# Solo se usan si NEXT_PUBLIC_GTM_ID está VACÍA. Sirven para medir sin
# contenedor. Nunca conviven con GTM (ahí nacen las conversiones duplicadas).
NEXT_PUBLIC_GA4_ID=G-B3CNGEL3QP
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Etiquetas de conversión de Google Ads, formato completo `AW-XXXXXXXXX/AbCdEfGhIjKl`.
# Solo aplican en el modo fallback anterior. Con GTM configurado se ignoran.
NEXT_PUBLIC_ADS_CONVERSION_WHATSAPP=
NEXT_PUBLIC_ADS_CONVERSION_FORMULARIO=
NEXT_PUBLIC_ADS_CONVERSION_LLAMADA=

# --- SEARCH CONSOLE --------------------------------------------------------
# Solo el valor del atributo content de la meta tag, sin las comillas ni el HTML.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
